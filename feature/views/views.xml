<odoo>
    <!--Se define el menu principal, aqui estaran todos los menús y     formularios-->
    <menuitem id="menu_my_learning_root"
        name="MyLearning"
    />
    <!--Se define nuestra pestaña principal al abrir el módulo, esta funciona como pestaña de navegación y para llamar a otras vistas o acciones-->
    <menuitem id="menu_elearning"
        parent="menu_my_learning_root"
        name="Elearning"
    />

    <!--Tenemos que definir una acción, esto para:
        1: Poder ver nuestra aplicación en el menú de home
        2: Poder interactuar con formularios (en este caso están definidos en otro XML)
    -->
    <menuitem id="menu_cursos"
        parent="menu_elearning"
        name="Cursos"
        action="action_elearning_curso"
    />
    <!-- llamada a acción dentro de cursos_views.xml→

 </odoo>

