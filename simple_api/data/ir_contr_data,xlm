<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron para descargar PDFs pendientes (existente) -->
        <record id="ir_cron_download_pending_pdfs" model="ir.cron">
            <field name="name">Descargar PDFs Pendientes - Boletas Honorarios</field>
            <field name="model_id" ref="model_boleta_honorarios"/>
            <field name="state">code</field>
            <field name="code">model.cron_download_pending_pdfs()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron existente para agrupar boletas por comuna -->
        <record id="ir_cron_agrupar_boletas_por_comuna" model="ir.cron">
            <field name="name">Agrupar boletas por comuna (simple_api)</field>
            <field name="model_id" ref="model_boleta_honorarios"/>
            <field name="state">code</field>
            <field name="code">model.agrupar_boletas_por_comuna()</field>
            <field name="active">True</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
        </record>

        <!-- Nuevo cron para sincronizar comunas desde SimpleAPI (diario) -->
        <record id="ir_cron_sync_comunas_simpleapi" model="ir.cron">
            <field name="name">Sincronizar Comunas - SimpleAPI</field>
            <field name="model_id" ref="model_boleta_comuna"/>
            <field name="state">code</field>
            <field name="code">model.sync_comunas()</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
