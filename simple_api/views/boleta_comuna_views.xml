<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Vista LISTA -->
  <record id="view_boleta_comuna_list" model="ir.ui.view">
    <field name="name">boleta.comuna.list</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <list string="Comunas">
        <field name="name"/>
        <field name="boletas_count"/>
      </list>
    </field>
  </record>

  <!-- Vista FORMULARIO -->
  <record id="view_boleta_comuna_form" model="ir.ui.view">
    <field name="name">boleta.comuna.form</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <form string="Comuna">
        <sheet>
          <group>
            <field name="name"/>
            <field name="boletas_count" readonly="1"/>
          </group>
          <notebook>
            <page string="Boletas">
              <field name="boleta_ids">
                <list>
                  <field name="numero_boleta"/>
                  <field name="partner_id"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
