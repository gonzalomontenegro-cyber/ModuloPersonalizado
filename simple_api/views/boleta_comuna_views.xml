<!-- views/boleta_comuna_views.xml (fragment) -->
<record id="view_boleta_comuna_list" model="ir.ui.view">
  <field name="arch" type="xml">
    <list string="Comunas">
      <field name="name"/>
      <field name="boleta_ids"/>
    </list>
  </field>
</record>


<record id="view_boleta_comuna_form" model="ir.ui.view">
  <field name="arch" type="xml">
    <form string="Comuna">
      <sheet>
        <group>
          <field name="name"/>
        </group>
        <notebook>
          <page string="Boletas">
            <field name="boleta_ids">
              <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
              </list>
            </field>
          </page>
        </notebook>
      </sheet>
    </form>
  </field>
</record>