<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista KANBAN -->
  <record id="view_boleta_comuna_kanban" model="ir.ui.view">
    <field name="name">boleta.comuna.kanban</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click o_kanban_card">
              <div class="o_primary">
                <strong><field name="name"/></strong>
              </div>
              <div>
                <field name="boletas_count"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Vista LISTA -->
  <record id="view_boleta_comuna_list" model="ir.ui.view">
    <field name="name">boleta.comuna.list</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <list>
        <field name="codigo"/>
        <field name="name"/>
        <field name="boletas_count"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM con botón para sincronizar -->
  <record id="view_boleta_comuna_form" model="ir.ui.view">
    <field name="name">boleta.comuna.form</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="sync_comunas" type="object" string="Actualizar desde SimpleAPI" class="btn-primary"/>
        </header>
        <sheet>
          <group>
            <field name="codigo"/>
            <field name="name"/>
            <field name="boletas_count" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para acceder a Comunas -->
  <record id="action_boleta_comuna" model="ir.actions.act_window">
    <field name="name">Comunas</field>
    <field name="res_model">boleta.comuna</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{}</field>
  </record>

</odoo>
