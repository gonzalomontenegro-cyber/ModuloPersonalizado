<odoo>
  <record id="view_boleta_comuna_tree" model="ir.ui.view">
    <field name="name">boleta.comuna.tree</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <list string="Comunas" create="false">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="view_boleta_comuna_form" model="ir.ui.view">
    <field name="name">boleta.comuna.form</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <form string="Comuna">
        <sheet>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_boleta_comuna" model="ir.actions.act_window">
    <field name="name">Comunas</field>
    <field name="res_model">boleta.comuna</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menú principal para boleta honorarios si no existe -->
  <menuitem id="menu_boleta_root" name="Boleta Honorarios" sequence="50"/>

  <!-- Menú Comunas bajo Boleta Honorarios -->
  <menuitem id="menu_boleta_comuna_root" name="Comunas" parent="menu_boleta_root" sequence="10"/>
  <menuitem id="menu_boleta_comuna" name="Gestionar Comunas" parent="menu_boleta_comuna_root" action="action_boleta_comuna" sequence="10"/>
</odoo>
