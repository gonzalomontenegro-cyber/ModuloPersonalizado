<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- List View -->
  <record id="view_boleta_comuna_list" model="ir.ui.view">
    <field name="name">boleta.comuna.list</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <list string="Comunas">
        <field name="name"/>
        <field name="boleta_ids" widget="many2many_tags" options="{'no_create': True}"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_boleta_comuna_form" model="ir.ui.view">
    <field name="name">boleta.comuna.form</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <form string="Comuna">
        <sheet>
          <group>
            <field name="name"/>
          </group>
          <notebook>
            <page string="Boletas">
              <field name="boleta_ids">
                <tree string="Boletas">
                  <field name="numero_boleta"/>
                  <field name="partner_id"/>
                  <field name="state"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
