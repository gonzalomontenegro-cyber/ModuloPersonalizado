<odoo>
  <record id="view_boleta_comuna_tree" model="ir.ui.view">
    <field name="name">boleta.comuna.tree</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <!-- otros campos si tienes -->
      </tree>
    </field>
  </record>

  <record id="view_boleta_comuna_form" model="ir.ui.view">
    <field name="name">boleta.comuna.form</field>
    <field name="model">boleta.comuna</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <!-- otros campos -->
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción -->
  <record id="action_boleta_comuna" model="ir.actions.act_window">
    <field name="name">Boleta Comunas</field>
    <field name="res_model">boleta.comuna</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menú (opcional) -->
  <menuitem id="menu_boleta_comuna_root" name="Comunas Boleta" sequence="99"/>
  <menuitem id="menu_boleta_comuna" name="Comunas" parent="menu_boleta_comuna_root" action="action_boleta_comuna"/>
</odoo>
